{
  "schemaVersion": 1,
  "id": "${id}",
  "version": "${version}",
  "name": "${name}",
  "description": "Rule based client-side hotbar sorting.",
  "icon": "assets/hotbarsorter/icon.png",
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": ["dev.hotbarsorter.fabric.HotbarSorterClient"],
    "modmenu": ["dev.hotbarsorter.fabric.compat.ModMenuCompat"]
  },
  "depends": {
    "fabricloader": ">=${loader}",
    "minecraft": "${minecraft}",
    "fabric-api": "*"
  },
  "suggests": { "modmenu": "*" }
}
